---
// src/components/PosterSelection.astro

import p1 from '../assets/Poster_Tabasco.png';
import p2 from '../assets/Magasine_1.png';
import p3 from '../assets/Poster_3.png';
import p4 from '../assets/Poster_10.png';
import p5 from '../assets/poster_amas.png';
import p6 from '../assets/Magasin_2.png';

const posters = [
  { src: p1.src, alt: 'Poster Tabasco' },
  { src: p2.src, alt: 'Magazine 1' },
  { src: p3.src, alt: 'Poster 3' },
  { src: p4.src, alt: 'Poster 10' },
  { src: p5.src, alt: 'Poster Amas' },
  { src: p6.src, alt: 'Magazine 2' },
];

// Rotations en éventail : de gauche très incliné vers droite
const rotations = [-22, -13, -6, 4, 12, 20];
// Valeurs SANS unité : elles sont multipliées par --k en CSS
// (--k = 1px sur desktop, une fraction de vw sur mobile)
const translateX = [-200, -120, -50, 20, 100, 175];
const translateY = [60, 30, 10, 10, 25, 55];
---

<section class="poster-section">

  <div class="poster-header">
    <h2 class="poster-title">
      <span class="script-s">S</span>élection de poster
    </h2>
  </div>

  <div class="poster-fan" id="poster-fan">
    {posters.map((p, i) => (
      <div
        class="poster-item"
        data-index={i}
        style={`
          --rot: ${rotations[i]}deg;
          --tx: ${translateX[i]};
          --ty: ${translateY[i]};
          --z: ${i + 1};
        `}
      >
        <div class="poster-overlay"></div>
        <img src={p.src} alt={p.alt} />
      </div>
    ))}
  </div>

  <div class="poster-cta">
    <a href="/projets" class="btn-voir-plus">Voir plus</a>
  </div>

</section>

<style>
  .poster-section {
    background: #000;
    padding: 9rem 2rem 6rem;
    overflow: hidden;
  }

  /* === TITRE === */
  .poster-header {
    margin-bottom: 1.5rem;
    padding-left: 3rem;
  }

  .poster-title {
    font-family: Helvetica, Arial, sans-serif;
    font-size: clamp(2.25rem, 11vw, 6rem);
    font-weight: bold;
    color: var(--color-green);
    margin: 0;
    line-height: 1;
  }

  .script-s {
    font-family: 'Edwardian Script', cursive;
    font-size: 1.5em; /* = 9rem quand le titre fait 6rem, et suit sur mobile */
    font-weight: normal;
    line-height: 0.8;
  }

  /* === FAN === */
  .poster-fan {
    --k: 1px; /* unité d'échelle des décalages : 1px desktop */
    position: relative;
    height: 580px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    margin-bottom: 3rem;
  }

  .poster-item {
    position: absolute;
    width: clamp(160px, 18vw, 250px);
    height: clamp(240px, 27vw, 375px);
    transform: translateX(calc(var(--tx) * var(--k)))
               translateY(calc(var(--ty) * var(--k)))
               rotate(var(--rot));
    transform-origin: bottom center;
    z-index: var(--z);
    cursor: pointer;
    transition: transform 0.45s cubic-bezier(0.23, 1, 0.32, 1),
                z-index 0s,
                box-shadow 0.45s ease;
    border-radius: 3px;
    overflow: hidden;
    box-shadow: 0 8px 30px rgba(0,0,0,0.5);
  }

  .poster-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.45s cubic-bezier(0.23, 1, 0.32, 1);
  }

  /* Overlay sombre sur chaque poster */
  .poster-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    z-index: 1;
    transition: opacity 0.35s ease;
    border-radius: 3px;
    pointer-events: none;
  }

  /* Poster "sélectionné" : au hover (souris) OU au tap (tactile, classe .is-active) */
  .poster-item.is-active {
    transform: translateX(calc(var(--tx) * var(--k)))
               translateY(calc(-60 * var(--k)))
               rotate(0deg) scale(1.08);
    z-index: 20 !important;
    box-shadow: 0 30px 80px rgba(0,0,0,0.8);
  }

  .poster-item.is-active .poster-overlay {
    opacity: 0;
  }

  .poster-item.is-active img {
    transform: scale(1.04);
  }

  /* Hover uniquement sur appareils avec souris (évite l'état "collé" au tap) */
  @media (hover: hover) {
    .poster-item:hover {
      transform: translateX(calc(var(--tx) * var(--k)))
                 translateY(calc(-60 * var(--k)))
                 rotate(0deg) scale(1.08);
      z-index: 20 !important;
      box-shadow: 0 30px 80px rgba(0,0,0,0.8);
    }

    .poster-item:hover .poster-overlay {
      opacity: 0;
    }

    .poster-item:hover img {
      transform: scale(1.04);
    }
  }

  /* === CTA === */
  .poster-cta {
    display: flex;
    justify-content: center;
    margin-top: 1rem;
  }

  .btn-voir-plus {
    display: inline-block;
    padding: 0.75rem 2.25rem;
    background-color: transparent;
    color: #fff;
    border: 1.5px solid rgba(255,255,255,0.5);
    border-radius: 50px;
    font-family: Helvetica, Arial, sans-serif;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    letter-spacing: 0.04em;
    transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }

  .btn-voir-plus:hover {
    background-color: var(--color-green);
    color: #000;
    border-color: var(--color-green);
  }

  /* === MOBILE / PETITE TABLETTE === */
  @media (max-width: 700px) {
    .poster-section {
      padding: 6rem 1rem 4rem;
    }

    .poster-header {
      padding-left: 0.5rem;
      margin-bottom: 1rem;
    }

    .poster-fan {
      /* Décalages proportionnels à la largeur d'écran :
         l'éventail garde la même forme sur tous les téléphones */
      --k: 0.1vw;
      height: 62vw;
      margin-bottom: 2rem;
    }

    .poster-item {
      width: 26vw;
      height: 39vw;
    }
  }
</style>

<script>
  // Tactile : un tap sur un poster le met en avant, un tap ailleurs (ou sur le même) le repose
  const posterItems = document.querySelectorAll<HTMLElement>('#poster-fan .poster-item');

  function clearActive() {
    posterItems.forEach((el) => el.classList.remove('is-active'));
  }

  posterItems.forEach((item) => {
    item.addEventListener('click', (e) => {
      e.stopPropagation();
      const wasActive = item.classList.contains('is-active');
      clearActive();
      if (!wasActive) item.classList.add('is-active');
    });
  });

  document.addEventListener('click', clearActive);
</script>