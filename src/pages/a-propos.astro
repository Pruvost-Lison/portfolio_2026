---
// src/pages/a-propos.astro
import Layout from '../layouts/Layout.astro';
import CvTurntable from '../components/CvTurntable.astro';
import aboutImg from '../assets/about.png';
import landingImg from '../assets/Photo_landing_page.png';
import cvUrl from '../assets/CV_Lison_Pruvost.pdf?url';

const cvFilename = 'CV_Lison_Pruvost.pdf';
const cvHref = cvUrl;

// Les mots entre *étoiles* sont surlignés en vert pendant l'animation.
const headline = `J'imagine des univers *visuels*, je compose des *images*, je donne *forme* aux idées.`;
const words = headline.split(' ').map((w) => {
  const [, star, t, punct] = w.match(/^(\*?)(.+?)\*?([.,;:!?]?)$/)!;
  return { t, punct, hl: !!star };
});

const skills = [
  {
    title: 'Points forts',
    items: [
      'Créative et sensible au détail',
      'Bonne compréhension des besoins utilisateurs',
      'Curieuse et polyvalente',
      'Esprit analytique',
      'Capacité à apprendre et à évoluer rapidement',
    ],
  },
  {
    title: 'Compétences',
    items: [
      'UI / UX design',
      'Front-end (HTML, CSS, bases JavaScript)',
      'Design graphique',
      'Montage vidéo',
      'Identité visuelle',
      'Prototypage et wireframes',
    ],
  },
  {
    title: 'Outils',
    items: [
      'Figma',
      'Suite Adobe (Photoshop, Illustrator, InDesign, Premiere Pro, After Effects, Audition)',
      'VS Code (CSS, HTML, JS, Astro, Tailwind)',
      'Suite Google / Office',
      'Notion',
      'DaVinci Resolve / CapCut',
    ],
  },
];

const timeline = [
  { year: '2023', title: 'Bac général', desc: 'Obtention du Baccalauréat mention européenne DNL' },
  { year: '2023 →', title: 'BUT MMI — IUT de Montbéliard', desc: 'Parcours Création Numérique. Design, développement web, audiovisuel.' },
  {
    year: 'S3 — 2024',
    title: `Semestre à l'étranger : Vanier College, Montréal`,
    desc: `Intégration dans un cégep anglophone en « Multimedia Integration ». Renforcement en design et création numérique.`,
    hl: true,
  },
  {
    year: '30 mars → 5 juin 2026',
    title: 'Stage — Communauté de Communes du Sundgau',
    desc: 'Service communication : affiches, brochures, vidéos et animations.',
  },
  { year: '2026', title: `En cours d'obtention du BUT MMI`, desc: 'En cours — diplôme prévu en juin 2027.' },
];
---

<Layout title="À Propos — Lison Pruvost">
  <div class="about">

    <div class="custom-cursor" id="cursor"></div>
    <div class="custom-cursor-dot" id="cursor-dot"></div>

    <!-- HERO -->
    <section class="sec about-hero dark">
      <h1 class="hero-title">
        <span class="script">À P</span><span class="sans">ropos</span>
      </h1>
      <div class="hero-img parallax-img">
        <img src={aboutImg.src} alt="Lison Pruvost" />
      </div>
    </section>

    <!-- INTRO + CV -->
    <section class="sec light">
      <div class="intro-inner">
        <h2 class="intro-title words" aria-label={words.map((w) => w.t).join(' ')}>
          {words.map((w, i) => (
            <span class="w" aria-hidden="true">
              <span style={`--i:${i}`}><span class:list={{ hl: w.hl }}>{w.t}</span>{w.punct}</span>
            </span>
          ))}
        </h2>
        <p class="intro-sub reveal" style="--d:.5s">
          Étudiante en BUT MMI à Montbéliard, je navigue entre design graphique, direction artistique et audiovisuel.
          J'aime expérimenter, toucher à différents domaines et donner forme à des idées.
        </p>
        <div class="reveal" style="--d:.2s">
          <CvTurntable cvHref={cvHref} cvFilename={cvFilename} />
        </div>
      </div>
    </section>

    <!-- COMPÉTENCES -->
    <section class="sec dark">
      <div class="sec-in skills">
        <div class="skills-img parallax-img">
          <img src={landingImg.src} alt="Lison Pruvost" />
        </div>
        <div class="skills-content">
          {skills.map((s, i) => (
            <div class="reveal" style={`--d:${i * 0.15}s`}>
              <h3>{s.title}</h3>
              <ul class="skill-list">{s.items.map((it) => <li>{it}</li>)}</ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- PARCOURS -->
    <section class="sec light">
      <h2 class="sec-in timeline-title reveal">Parcours &amp; apprentissages</h2>

      <div class="sec-in timeline-body">
        <div class="timeline-text reveal">
          <p>
            Actuellement en 3ᵉ année de BUT Métiers du Multimédia et de l’Internet à Montbéliard, je développe une approche polyvalente de la création visuelle, entre design graphique, direction artistique et audiovisuel.
          </p>
          <p>
            Dans le cadre de mon parcours, j’ai réalisé un semestre d’études au <strong>Vanier College</strong>, un cégep anglophone situé à Montréal. Cette expérience m’a permis de découvrir un nouvel environnement culturel et d’enrichir ma pratique du design et de la création.
          </p>
          <p>
            J’ai également effectué un stage au sein du service communication de la <strong>Communauté de Communes du Sundgau (CCS)</strong>, où j’ai participé à la réalisation de différents supports visuels : affiches, brochures, vidéos et animations. Une expérience qui m’a permis de mettre en pratique mes compétences et de mieux comprendre les enjeux de la communication visuelle en milieu professionnel.
          </p>
          <p>
            Curieuse et polyvalente, j’aime explorer différents domaines, expérimenter de nouvelles approches et construire des univers visuels variés. Je m’intéresse particulièrement au design graphique, à l’image et à la vidéo, avec l’envie de continuer à développer ma créativité à travers des projets divers.
          </p>
        </div>

        <div class="timeline-events">
          {timeline.map((e, i) => (
            <div class="tl-item reveal" style={`--d:${i * 0.1}s`}>
              <i class:list={['tl-dot', { 'tl-dot-green': e.hl }]}></i>
              <div>
                <span class="tl-year">{e.year}</span>
                <h4>{e.title}</h4>
                <p>{e.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="sec about-cta dark">
      <p class="cta-label reveal">Envie de collaborer ?</p>
      <h2 class="cta-big script reveal" style="--d:.1s">Me Contacter</h2>
      <div class="cta-actions reveal" style="--d:.2s">
        <a href="/contact" class="btn btn-main">Me contacter</a>
        <a href={cvHref} download={cvFilename} class="btn btn-ghost">Télécharger le CV</a>
      </div>
    </section>

  </div>
</Layout>

<style is:global>
  * { cursor: none; }
  .custom-cursor {
    width: 36px; height: 36px;
    border: 1.5px solid var(--color-green, #9bff00);
    border-radius: 50%;
    position: fixed; top: 0; left: 0;
    pointer-events: none; z-index: 9999;
    transform: translate(-50%, -50%);
    transition: width 0.2s, height 0.2s, background 0.2s;
    mix-blend-mode: difference;
  }
  .custom-cursor-dot {
    width: 5px; height: 5px;
    background: var(--color-green, #9bff00);
    border-radius: 50%;
    position: fixed; top: 0; left: 0;
    pointer-events: none; z-index: 10000;
    transform: translate(-50%, -50%);
  }
  .custom-cursor.hovering { width: 60px; height: 60px; background: rgba(155, 255, 0, 0.1); }
</style>

<style>
  .about { --g: var(--color-green, #9bff00); font-family: Helvetica, Arial, sans-serif; }
  .dark { background: #000; color: #fff; }
  .light { background: #f5f5f0; color: #000; }
  .sec { padding: 7rem 5rem; }
  .sec-in { max-width: 1200px; margin: 0 auto; }
  .script { font-family: 'Edwardian Script', cursive; font-weight: normal; }
  .sans { font-weight: 900; }

  /* ── Animations ── */
  .reveal {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.6s ease, transform 0.6s ease;
    transition-delay: var(--d, 0s);
  }
  .reveal.visible { opacity: 1; transform: none; }

  /* ── Hero ── */
  .about-hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3rem;
    padding: 6rem 3rem 4rem;
    overflow: hidden;
  }
  .hero-title { margin: 0; line-height: 1.1; text-align: center; color: var(--g); font-weight: normal; }
  .hero-title .script { font-size: clamp(6rem, 14vw, 9rem); }
  .hero-title .sans { font-size: clamp(4rem, 9vw, 6rem); }
  .hero-img { width: clamp(200px, 28vw, 360px); height: clamp(260px, 36vw, 480px); }

  .parallax-img { overflow: hidden; border-radius: 3px; }
  .parallax-img img {
    display: block;
    width: 100%;
    height: 120%;
    object-fit: cover;
    object-position: center top;
    will-change: transform;
  }

  /* ── Intro ── */
  .intro-inner { max-width: 1000px; margin: 0 auto; }
  .intro-title {
    max-width: 16em;
    margin: 0 0 1.5rem;
    font-size: clamp(2rem, 4.4vw, 3.8rem);
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  /* un masque par mot : le mot monte depuis le bas */
  .w { display: inline-block; overflow: hidden; vertical-align: top; margin-right: 0.28em; padding-bottom: 0.12em; }
  .w > span {
    display: inline-block;
    transform: translateY(115%);
    transition: transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) calc(var(--i) * 70ms);
  }
  .hl {
    background: linear-gradient(var(--g), var(--g)) 0 88% / 0% 36% no-repeat;
    transition: background-size 0.7s ease calc(var(--i) * 70ms + 0.6s);
  }
  .words.visible .w > span { transform: none; }
  .words.visible .hl { background-size: 100% 36%; }

  .intro-sub { max-width: 34rem; margin: 0 0 4.5rem; font-size: 1.05rem; line-height: 1.7; color: #444; }

  /* ── Compétences ── */
  .skills { display: grid; grid-template-columns: 1fr 1.4fr; gap: 6rem; align-items: start; }
  .skills-img { height: clamp(400px, 55vw, 650px); position: sticky; top: 6rem; }
  .skills-content { display: flex; flex-direction: column; gap: 3.5rem; padding-top: 1rem; }
  .skills-content h3 {
    margin: 0 0 1rem;
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    font-weight: 900;
    letter-spacing: -0.02em;
    color: var(--g);
  }
  .skill-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.5rem; }
  .skill-list li { position: relative; padding-left: 1rem; font-size: 0.95rem; line-height: 1.5; color: rgba(255, 255, 255, 0.75); }
  .skill-list li::before { content: '—'; position: absolute; left: -0.5rem; color: var(--g); opacity: 0.5; }

  /* ── Parcours ── */
  .timeline-title { margin-bottom: 5rem; font-size: clamp(2rem, 4vw, 3.5rem); font-weight: 900; line-height: 1.1; color: #000; }
  .timeline-body { display: grid; grid-template-columns: 1fr 1fr; gap: 6rem; }
  .timeline-text p { margin: 0 0 1.5rem; font-size: 0.95rem; line-height: 1.85; color: #333; text-align: justify; }
  .timeline-text strong { color: #000; }

  .timeline-events { position: relative; padding-left: 2rem; }
  .timeline-events::before { content: ''; position: absolute; left: 0; top: 8px; bottom: 8px; width: 1px; background: rgba(0, 0, 0, 0.15); }
  .tl-item { position: relative; padding-bottom: 2.5rem; }
  .tl-dot {
    position: absolute;
    left: -2.45rem;
    top: 0.35rem;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #ccc;
    border: 2px solid #f5f5f0;
  }
  .tl-dot-green { background: var(--g); box-shadow: 0 0 12px rgba(155, 255, 0, 0.5); }
  .tl-year { display: block; margin-bottom: 0.3rem; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--g); }
  .tl-item h4 { margin: 0 0 0.4rem; font-size: 1rem; line-height: 1.3; }
  .tl-item p { margin: 0; font-size: 0.85rem; line-height: 1.6; color: #666; }

  /* ── CTA ── */
  .about-cta { padding: 8rem 5rem; text-align: center; }
  .cta-label { margin: 0 0 1rem; font-size: 0.85rem; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(255, 255, 255, 0.4); }
  .cta-big { margin: 0 0 3rem; font-size: clamp(5rem, 12vw, 11rem); line-height: 1; color: var(--g); }
  .cta-actions { display: flex; gap: 1.5rem; justify-content: center; flex-wrap: wrap; }
  .btn {
    padding: 1rem 2.5rem;
    border-radius: 50px;
    font-size: 0.9rem;
    letter-spacing: 0.06em;
    text-decoration: none;
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s, color 0.2s;
  }
  .btn-main { background: var(--g); color: #000; font-weight: 700; }
  .btn-main:hover { transform: translateY(-3px); box-shadow: 0 10px 30px rgba(155, 255, 0, 0.3); }
  .btn-ghost { color: #fff; font-weight: 600; border: 1.5px solid rgba(255, 255, 255, 0.3); }
  .btn-ghost:hover { border-color: var(--g); color: var(--g); }

  @media (prefers-reduced-motion: reduce) {
    .reveal, .w > span { transition: none; transform: none; opacity: 1; }
    .hl { background-size: 100% 36%; }
  }

  @media (max-width: 900px) {
    .sec, .about-cta { padding: 5rem 1.5rem; }
    .skills, .timeline-body { grid-template-columns: 1fr; gap: 3rem; }
    .skills-img { position: relative; top: 0; height: 320px; }
  }
</style>

<script>
  // ── Curseur ──
  const cursor = document.getElementById('cursor')!;
  const dot = document.getElementById('cursor-dot')!;
  let cx = 0, cy = 0, tx = 0, ty = 0;

  addEventListener('mousemove', (e) => {
    tx = e.clientX;
    ty = e.clientY;
    dot.style.left = tx + 'px';
    dot.style.top = ty + 'px';
  });
  (function loop() {
    cx += (tx - cx) * 0.12;
    cy += (ty - cy) * 0.12;
    cursor.style.left = cx + 'px';
    cursor.style.top = cy + 'px';
    requestAnimationFrame(loop);
  })();
  document.querySelectorAll('a, button, [role=button]').forEach((el) => {
    el.addEventListener('mouseenter', () => cursor.classList.add('hovering'));
    el.addEventListener('mouseleave', () => cursor.classList.remove('hovering'));
  });

  // ── Apparition au scroll ──
  const io = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        e.target.classList.add('visible');
        io.unobserve(e.target);
      }),
    { threshold: 0.15 }
  );
  document.querySelectorAll('.reveal, .words').forEach((el) => io.observe(el));

  // ── Parallaxe ──
  const wraps = document.querySelectorAll<HTMLElement>('.parallax-img');
  const parallax = () =>
    wraps.forEach((w) => {
      const r = w.getBoundingClientRect();
      if (r.bottom < 0 || r.top > innerHeight) return;
      w.querySelector('img')!.style.transform = `translateY(${(r.top + r.height / 2 - innerHeight / 2) * 0.15}px)`;
    });
  addEventListener('scroll', parallax, { passive: true });
  parallax();
</script>