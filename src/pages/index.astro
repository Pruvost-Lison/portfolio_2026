---
import Layout from '../layouts/Layout.astro';
import HeroScramble from '../components/HeroScramble.astro';
import IndexProjet from '../components/IndexProjet.astro';
import HeroAbout from '../components/HeroAbout.astro';
import introcard from '../assets/Card.svg';
import ScrollingBanner from '../components/ScrollingBanner.astro';
import StackCards from '../components/StackCards.astro';
import PosterSelection from '../components/PosterSelection.astro';
import photoMentions from '../assets/photo_mentions.svg';
---

<Layout title="Lison Pruvost - Portfolio">
  <div class="custom-cursor" id="cursor"></div>
  <div class="custom-cursor-dot" id="cursor-dot"></div>
  <HeroScramble />

  <HeroAbout 
    bannerText="PORTFOLIO"
    titleLine1="À"
    titleLine2="ropos"
    cardSvg={introcard}
  />

  <IndexProjet />
  <StackCards />
  <PosterSelection />

 
</Layout>

<style>

    * { cursor: none; }

  .custom-cursor {
    width: 36px; height: 36px;
    border: 1.5px solid var(--color-green, #b8f000);
    border-radius: 50%;
    position: fixed; top: 0; left: 0;
    pointer-events: none; z-index: 9999;
    transform: translate(-50%, -50%);
    transition: width 0.2s, height 0.2s, background 0.2s;
    mix-blend-mode: difference;
  }
  .custom-cursor-dot {
    width: 5px; height: 5px;
    background: var(--color-green, #b8f000);
    border-radius: 50%;
    position: fixed; top: 0; left: 0;
    pointer-events: none; z-index: 10000;
    transform: translate(-50%, -50%);
  }
  .custom-cursor.hovering { width: 56px; height: 56px; background: rgba(184,240,0,0.08); }

  /* === SECTION STAGE === */
  .stage-section {
    padding-top: 5rem;
    padding-bottom: 6rem;
  }

  /* Titre : même style que heroAbout — script + bold */
  .stage-title {
    color: var(--color-green);
    font-weight: normal;
    line-height: 1.1;
    margin-bottom: 3.5rem;
  }

  .stage-title-script {
    font-family: 'Edwardian Script', cursive;
    font-weight: normal;
    font-size: clamp(4rem, 8vw, 8rem);
  }

  .stage-title-bold {
    font-family: Helvetica, Arial, sans-serif;
    font-weight: bold;
    font-size: clamp(2.5rem, 5.5vw, 5.5rem);
  }

  /* Grille 2 colonnes */
  .stage-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 768px) {
    .stage-grid {
      grid-template-columns: 1fr 1fr;
      gap: 5rem;
    }
  }

  /* Colonne gauche */
  .stage-left {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .stage-desc {
    font-family: Helvetica, Arial, sans-serif;
    font-size: clamp(1rem, 1.8vw, 1.2rem);
    font-weight: bold;
    color: var(--color-white, #fff);
    line-height: 1.45;
    margin: 0;
  }

  .stage-label {
    font-family: Helvetica, Arial, sans-serif;
    font-size: 0.9rem;
    font-style: italic;
    color: var(--color-white, #fff);
    opacity: 0.7;
    margin: 0;
  }

  .stage-dates {
    font-family: Helvetica, Arial, sans-serif;
    font-size: clamp(2rem, 4vw, 3.5rem);
    color: var(--color-white, #fff);
    margin: 0;
    line-height: 1.2;
  }

  .stage-divider {
    width: 60%;
    height: 1px;
    background-color: var(--color-white, #fff);
    opacity: 0.3;
    margin-top: 0.5rem;
  }

  /* Colonne droite : photo */
  .stage-right {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .stage-photo {
    width: 100%;
    max-width: 520px;
    height: auto;
    display: block;
    opacity: 0;
    filter: blur(14px);
    transform: translateY(10px);
    transition: opacity 1s ease, filter 1.2s ease, transform 1s ease;
  }

  .stage-photo.is-visible {
    opacity: 1;
    filter: blur(0px);
    transform: translateY(0);
  }
</style>

<script>
  const cursor = document.getElementById('cursor');
  const dot = document.getElementById('cursor-dot');
  let cx = 0, cy = 0, tx = 0, ty = 0;

  document.addEventListener('mousemove', (e) => {
    tx = e.clientX; ty = e.clientY;
    dot.style.left = tx + 'px';
    dot.style.top = ty + 'px';
  });

  (function animCursor() {
    cx += (tx - cx) * 0.12;
    cy += (ty - cy) * 0.12;
    cursor.style.left = cx + 'px';
    cursor.style.top = cy + 'px';
    requestAnimationFrame(animCursor);
  })();

  document.querySelectorAll('a, button').forEach(el => {
    el.addEventListener('mouseenter', () => cursor.classList.add('hovering'));
    el.addEventListener('mouseleave', () => cursor.classList.remove('hovering'));
  });

  /* Photo reveal — même logique que heroAbout */
  const stagePhoto = document.getElementById('stagePhoto') as HTMLImageElement | null;

  if (stagePhoto) {
    const obs = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            stagePhoto.classList.add('is-visible');
          } else {
            stagePhoto.classList.remove('is-visible');
          }
        });
      },
      { threshold: 0.2 }
    );
    obs.observe(stagePhoto);
  }
</script>