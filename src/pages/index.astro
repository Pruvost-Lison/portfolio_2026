---
import Layout from '../layouts/Layout.astro';
import Preloader from '../components/Preloader.astro';
import HeroScramble from '../components/HeroScramble.astro';
import IndexProjet from '../components/IndexProjet.astro';
import HeroAbout from '../components/HeroAbout.astro';
import introcard from '../assets/Card.svg';
import ScrollingBanner from '../components/ScrollingBanner.astro';
import StackCards from '../components/StackCards.astro';
import PosterSelection from '../components/PosterSelection.astro';
import photoMentions from '../assets/photo_mentions.svg';
---

<Layout title="Lison Pruvost - Portfolio">
  <Preloader />
  <div class="custom-cursor" id="cursor"></div>
  <div class="custom-cursor-dot" id="cursor-dot"></div>
  <HeroScramble />

  <HeroAbout
    bannerText="PORTFOLIO"
    titleLine1="À"
    titleLine2="ropos"
    cardSvg={introcard}
  />

  <IndexProjet />
  <StackCards />
  <PosterSelection />
</Layout>

<!-- Correction des bandes roses du hero -->
<style is:global>
  .hero-section .banner-top,
  .hero-section .banner-bottom {
    top: 12.5% !important;
    transform-origin: center !important;
  }
  .hero-section .banner-top    { transform: rotate(-8deg) !important; }
  .hero-section .banner-bottom { transform: rotate(8deg) !important; }

  .hero-section .scrolling-content {
    flex-shrink: 0;
    white-space: pre !important;
    animation: bannerLoop 60s linear infinite !important;
  }
  .hero-section .reverse .scrolling-content {
    animation: bannerLoopReverse 50s linear infinite !important;
  }

  @keyframes bannerLoop {
    from { transform: translateX(0); }
    to   { transform: translateX(-100%); }
  }
  @keyframes bannerLoopReverse {
    from { transform: translateX(-100%); }
    to   { transform: translateX(0); }
  }
</style>

<style>
  /* Curseur masqué seulement avec une souris */
  @media (hover: hover) and (pointer: fine) {
    * { cursor: none; }
  }

  .custom-cursor {
    width: 36px; height: 36px;
    border: 1.5px solid var(--color-green, #b8f000);
    border-radius: 50%;
    position: fixed; top: 0; left: 0;
    pointer-events: none; z-index: 9999;
    transform: translate(-50%, -50%);
    transition: width 0.2s, height 0.2s, background 0.2s;
    mix-blend-mode: difference;
  }
  .custom-cursor-dot {
    width: 5px; height: 5px;
    background: var(--color-green, #b8f000);
    border-radius: 50%;
    position: fixed; top: 0; left: 0;
    pointer-events: none; z-index: 10000;
    transform: translate(-50%, -50%);
  }
  .custom-cursor.hovering { width: 56px; height: 56px; background: rgba(184,240,0,0.08); }

  /* Écrans tactiles : pas de curseur personnalisé */
  @media (hover: none), (pointer: coarse) {
    .custom-cursor,
    .custom-cursor-dot {
      display: none;
    }
  }
</style>

<script>
  const cursor = document.getElementById('cursor');
  const dot = document.getElementById('cursor-dot');
  const hasMouse = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  if (cursor && dot && hasMouse) {
    let cx = 0, cy = 0, tx = 0, ty = 0;

    document.addEventListener('mousemove', (e) => {
      tx = e.clientX; ty = e.clientY;
      dot.style.left = tx + 'px';
      dot.style.top = ty + 'px';
    });

    (function animCursor() {
      cx += (tx - cx) * 0.12;
      cy += (ty - cy) * 0.12;
      cursor.style.left = cx + 'px';
      cursor.style.top = cy + 'px';
      requestAnimationFrame(animCursor);
    })();

    document.querySelectorAll('a, button').forEach((el) => {
      el.addEventListener('mouseenter', () => cursor.classList.add('hovering'));
      el.addEventListener('mouseleave', () => cursor.classList.remove('hovering'));
    });
  }
</script>