---
// src/pages/projets/[id].astro
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { projets, getProjet, type Projet } from '../../data/projets';
import { getImage, getMedia } from '../../data/images';

export function getStaticPaths() {
  return projets.map((p) => ({ params: { id: p.slug } }));
}

const { id } = Astro.params;
const projet = getProjet(id as string);

if (!projet) {
  return Astro.redirect('/404');
}

const autres = projet.similaires
  .map((slug) => getProjet(slug))
  .filter((p): p is Projet => Boolean(p))
  .slice(0, 3);
---

<Layout title={`${projet.titre} — Lison Pruvost`}>

  <!-- Curseur -->
  <div class="custom-cursor" id="cursor"></div>
  <div class="custom-cursor-dot" id="cursor-dot"></div>

  <!-- ══════════ HERO ══════════ -->
  <section class="projet-hero">
    <a href="/projets" class="btn-retour">← Projets</a>
    <div class="projet-hero-inner">

      <!-- Colonne gauche : infos -->
      <div class="projet-hero-left">
        <h1 class="projet-title reveal">
          <span class="script-letter">{projet.titre.charAt(0)}</span><span class="title-rest">{projet.titre.slice(1)}</span>
        </h1>

        <p class="projet-extrait reveal">{projet.extrait}</p>

        <div class="competences-wrap reveal">
          {projet.competences.map((comp) => (
            <span class="competence-tag">{comp}</span>
          ))}
        </div>

        <hr class="projet-divider" />

        <div class="projet-explication reveal">
          {projet.explication.map((para) => <p>{para}</p>)}
        </div>

        {projet.embed && (
          <div class="projet-embed reveal">
            <iframe
              src={projet.embed}
              title={projet.titre}
              frameborder="0"
              allowfullscreen
              allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
              loading="lazy"
            ></iframe>
          </div>
        )}

        {projet.voirSite && (
          <a href={projet.voirSite} target="_blank" rel="noopener" class="btn-voir-site reveal">
            Voir le projet →
          </a>
        )}
      </div>

      <!-- Colonne droite : galerie -->
      <div class="projet-hero-right">
        <div class="galerie-grid">
          {projet.galerie.map((file, i) => {
            const media = getMedia(file);
            return (
              <div
                class={`galerie-item ${i === 0 || i >= projet.galerie.length - 2 ? 'galerie-item-full' : ''} reveal`}
                style={`transition-delay: ${i * 0.08}s`}
              >
                {media.type === 'video' ? (
                  <video src={media.src} autoplay loop muted playsinline preload="metadata"></video>
                ) : (
                  <Image
                    src={media.src}
                    alt={`${projet.titre} — image ${i + 1}`}
                    widths={[600, 1000, 1400]}
                    sizes="(max-width: 900px) 100vw, 55vw"
                    loading="lazy"
                  />
                )}
              </div>
            );
          })}
        </div>
      </div>

    </div>
  </section>

  <!-- ══════════ OBJECTIFS ══════════ -->
  <section class="projet-objectifs">
    <div class="objectifs-inner">
      <h2 class="objectifs-title reveal">Objectifs du projet</h2>
      <div class="objectifs-content reveal">
        {projet.objectifs.map((line) => (
          <div class="objectif-line">
            <span class="objectif-bullet">—</span>
            <p>{line}</p>
          </div>
        ))}
      </div>

      <div class="resultat-wrap reveal">
        <h2 class="objectifs-title" style="margin-top: 3rem;">Résultat</h2>
        <p class="resultat-text">{projet.resultat}</p>
      </div>

      {projet.rapportIa && (
        <div class="resultat-wrap reveal">
          <h2 class="objectifs-title" style="margin-top: 3rem;">Rapport IA</h2>
          <p class="resultat-text">{projet.rapportIa}</p>
        </div>
      )}
    </div>
  </section>

  <!-- ══════════ VOIR D'AUTRES PROJETS ══════════ -->
  <section class="autres-projets">
    <div class="autres-inner">
      <h2 class="autres-title reveal">
        <span class="script-v">V</span>oir d'autres projets
      </h2>
      <div class="autres-grid">
        {autres.length === 0 && <p class="autres-placeholder">Aucun projet similaire.</p>}
        {autres.map((p) => (
          <a href={`/projets/${p.slug}`} class="autre-card reveal">
            <Image
              src={getImage(p.photo)}
              alt={p.nom}
              widths={[400, 700, 1000]}
              sizes="(max-width: 600px) 100vw, 33vw"
              loading="lazy"
            />
            <div class="autre-card-overlay"></div>
            <div class="autre-card-label">
              <div class="autre-card-top">
                <span class="autre-card-name">{p.nom}</span>
                <span class="autre-card-btn">Voir plus</span>
              </div>
              <div class="autre-card-comps">
                {p.competencesCarte.map((c) => <span class="autre-card-comp">{c}</span>)}
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

</Layout>

<style is:global>
  .custom-cursor {
    width: 36px; height: 36px;
    border: 1.5px solid var(--color-green, #b8f000);
    border-radius: 50%;
    position: fixed; top: 0; left: 0;
    pointer-events: none; z-index: 9999;
    transform: translate(-50%, -50%);
    transition: width 0.2s, height 0.2s, background 0.2s;
    mix-blend-mode: difference;
  }
  .custom-cursor-dot {
    width: 5px; height: 5px;
    background: var(--color-green, #b8f000);
    border-radius: 50%;
    position: fixed; top: 0; left: 0;
    pointer-events: none; z-index: 10000;
    transform: translate(-50%, -50%);
  }
  .custom-cursor.hovering { width: 56px; height: 56px; background: rgba(184,240,0,0.08); }
</style>

<style is:global>
  * { cursor: none; }

  /* ── HERO ── */
  .projet-hero {
    background: #f5f5f0;
    min-height: 100vh;
    padding: 5rem 5rem 5rem;
    position: relative;
  }

  .btn-retour {
    position: absolute;
    top: 1.8rem;
    left: 5rem;
    font-family: Helvetica, Arial, sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: #000;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    opacity: 0.5;
    transition: opacity 0.2s ease;
    z-index: 10;
  }
  .btn-retour:hover { opacity: 1; }

  .projet-hero-inner {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 5rem;
    max-width: 1300px;
    margin: 0 auto;
    align-items: start;
  }

  .projet-hero-left {
    position: sticky;
    top: 6rem;
    align-self: start;
  }

  .projet-title {
    font-weight: normal;
    line-height: 1;
    margin: 0 0 1.5rem;
    color: #000;
  }
  .script-letter {
    font-family: 'Edwardian Script', cursive;
    font-size: clamp(5rem, 10vw, 9rem);
    font-weight: normal;
    color: #000;
  }
  .title-rest {
    font-family: Helvetica, Arial, sans-serif;
    font-size: clamp(3rem, 6vw, 5.5rem);
    font-weight: 900;
    letter-spacing: -0.03em;
  }

  .projet-extrait {
    font-family: Helvetica, Arial, sans-serif;
    font-size: 0.95rem;
    line-height: 1.7;
    color: #333;
    max-width: 480px;
    margin-bottom: 1.5rem;
  }

  .competences-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 2rem;
  }
  .competence-tag {
    font-family: Helvetica, Arial, sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
    color: #000;
    border: 1.5px solid #000;
    border-radius: 50px;
    padding: 0.3rem 1rem;
    letter-spacing: 0.04em;
    transition: background 0.2s, color 0.2s;
  }
  .competence-tag:hover {
    background: #000;
    color: var(--color-green, #b8f000);
  }

  .projet-divider {
    border: none;
    border-top: 1px solid rgba(0,0,0,0.12);
    margin: 2rem 0;
  }

  .projet-explication {
    font-family: Helvetica, Arial, sans-serif;
    font-size: 0.9rem;
    line-height: 1.85;
    color: #444;
    margin-bottom: 2rem;
    text-align: justify;
  }
  .projet-explication p { margin: 0 0 1rem; }
  .projet-explication p:last-child { margin-bottom: 0; }

  .projet-embed { margin-bottom: 2rem; }
  .projet-embed iframe {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    height: auto;
    border: 0;
    border-radius: 12px;
  }

  .btn-voir-site {
    display: inline-block;
    padding: 0.7rem 2rem;
    background: #000;
    color: var(--color-green, #b8f000);
    font-family: Helvetica, Arial, sans-serif;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-decoration: none;
    border-radius: 50px;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .btn-voir-site:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.2);
  }

  /* Galerie */
  .galerie-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.8rem;
  }
  .galerie-item {
    overflow: hidden;
    border-radius: 3px;
    background: #e8e8e4;
    aspect-ratio: 4 / 5; 
  }
  .galerie-item-full {
    grid-column: 1 / -1;
    aspect-ratio: auto;            /* les images pleine largeur gardent leur hauteur */
  height: clamp(200px, 28vw, 380px);
  }
  .galerie-item img,
  .galerie-item video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }
  .galerie-item:hover img,
  .galerie-item:hover video { transform: scale(1.04); }

  /* ── OBJECTIFS ── */
  .projet-objectifs {
    background: #fff;
    padding: 6rem 5rem;
    border-top: 1px solid rgba(0,0,0,0.06);
  }
  .objectifs-inner {
    max-width: 800px;
    margin: 0 auto;
  }
  .objectifs-title {
    font-family: Helvetica, Arial, sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #999;
    margin-bottom: 2rem;
  }
  .objectif-line {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    padding: 0.6rem 0;
    border-bottom: 1px solid rgba(0,0,0,0.06);
  }
  .objectif-bullet {
    font-family: Helvetica, Arial, sans-serif;
    font-size: 0.85rem;
    color: var(--color-green, #b8f000);
    filter: brightness(0.7);
    flex-shrink: 0;
  }
  .objectif-line p {
    font-family: Helvetica, Arial, sans-serif;
    font-size: 0.95rem;
    color: #222;
    line-height: 1.6;
    margin: 0;
  }
  .resultat-text {
    font-family: Helvetica, Arial, sans-serif;
    font-size: 0.95rem;
    line-height: 1.85;
    color: #333;
    margin: 0;
    text-align: justify;
  }

  /* ── AUTRES PROJETS ── */
  .autres-projets {
    background: #fff;
    padding: 4rem 5rem 7rem;
  }
  .autres-inner {
    max-width: 1300px;
    margin: 0 auto;
  }
  .autres-title {
    font-family: Helvetica, Arial, sans-serif;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 900;
    color: #000;
    margin-bottom: 3rem;
    line-height: 1;
  }
  .script-v {
    font-family: 'Edwardian Script', cursive;
    font-size: 1.25em;
    font-weight: normal;
  }
  .autres-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .autres-placeholder {
    color: #999;
    font-size: 0.85rem;
    font-family: Helvetica, Arial, sans-serif;
  }
  .autre-card {
    position: relative;
    overflow: hidden;
    border-radius: 3px;
    background: #e8e8e4;
    aspect-ratio: 4/3;
    text-decoration: none;
    display: block;
  }
  .autre-card img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }
  .autre-card:hover img { transform: scale(1.04); }
  .autre-card-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .autre-card:hover .autre-card-overlay { opacity: 1; }
  .autre-card-label {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    padding: 1.2rem;
    color: #fff;
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .autre-card:hover .autre-card-label { opacity: 1; }
  .autre-card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    width: 100%;
  }
  .autre-card-name {
    font-family: Helvetica, Arial, sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
    line-height: 1.4;
    max-width: 60%;
  }
  .autre-card-btn {
    font-family: Helvetica, Arial, sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
    color: #fff;
    border: 1.5px solid rgba(255,255,255,0.7);
    border-radius: 50px;
    padding: 0.35rem 1rem;
    white-space: nowrap;
  }
  .autre-card-comps {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    justify-content: center;
    width: 100%;
  }
  .autre-card-comp {
    font-family: Helvetica, Arial, sans-serif;
    font-size: 0.8rem;
    font-weight: 500;
    color: rgba(255,255,255,0.9);
    letter-spacing: 0.03em;
  }

  /* ── REVEAL ── */
  .reveal {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 900px) {
    .projet-hero { padding: 5rem 2rem 4rem; }
    .projet-hero-inner { grid-template-columns: 1fr; gap: 3rem; }
    .projet-hero-left { position: static; }
    .galerie-grid { grid-template-columns: 1fr; }
    .projet-objectifs, .autres-projets { padding: 4rem 2rem; }
    .autres-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 600px) {
    .autres-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  // ── Curseur ──
  const cursor = document.getElementById('cursor') as HTMLElement;
  const dot = document.getElementById('cursor-dot') as HTMLElement;
  let cx = 0, cy = 0, tx = 0, ty = 0;

  document.addEventListener('mousemove', (e) => {
    tx = e.clientX; ty = e.clientY;
    dot.style.left = tx + 'px';
    dot.style.top = ty + 'px';
  });

  (function animCursor() {
    cx += (tx - cx) * 0.12;
    cy += (ty - cy) * 0.12;
    cursor.style.left = cx + 'px';
    cursor.style.top = cy + 'px';
    requestAnimationFrame(animCursor);
  })();

  document.querySelectorAll('a, button').forEach((el) => {
    el.addEventListener('mouseenter', () => cursor.classList.add('hovering'));
    el.addEventListener('mouseleave', () => cursor.classList.remove('hovering'));
  });

  // ── Reveal au scroll ──
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) e.target.classList.add('visible');
      });
    },
    { threshold: 0.12 }
  );
  document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
</script>