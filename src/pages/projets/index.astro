---
// src/pages/projets/index.astro
import Layout from '../../layouts/Layout.astro';
import headerVideo from '../../assets/header_projets.mp4';
---

<Layout title="Projets — Lison Pruvost">

  <div class="custom-cursor" id="cursor"></div>
  <div class="custom-cursor-dot" id="cursor-dot"></div>

  <section class="projets-hero">
    <video class="hero-video" autoplay loop muted playsinline>
      <source src={headerVideo} type="video/mp4" />
    </video>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <h1 class="hero-title">
        <span class="script-p">P</span><span class="hero-sans">rojets</span>
      </h1>
    </div>
  </section>

  <section class="projets-body">
    <div class="filtres-wrap">
      <button class="filtre-btn" data-filter="all">Tous</button>
      <div id="filtres-dynamiques" class="filtres-dynamic"></div>
    </div>
    <div class="projets-meta">
      <span id="projets-count" class="projets-count">— projets</span>
    </div>
    <div class="projets-grid" id="projets-grid">
      <div class="projets-loading">Chargement…</div>
    </div>
  </section>

</Layout>

<style is:global>
  * { cursor: none; }

  .custom-cursor {
    width: 36px; height: 36px;
    border: 1.5px solid var(--color-green, #b8f000);
    border-radius: 50%;
    position: fixed; top: 0; left: 0;
    pointer-events: none; z-index: 9999;
    transform: translate(-50%, -50%);
    transition: width 0.2s, height 0.2s, background 0.2s;
    mix-blend-mode: difference;
  }
  .custom-cursor-dot {
    width: 5px; height: 5px;
    background: var(--color-green, #b8f000);
    border-radius: 50%;
    position: fixed; top: 0; left: 0;
    pointer-events: none; z-index: 10000;
    transform: translate(-50%, -50%);
  }
  .custom-cursor.hovering { width: 56px; height: 56px; background: rgba(184,240,0,0.08); }

  .projets-hero {
    position: relative;
    height: 100vh;
    overflow: hidden;
    background: #000;
  }
  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    opacity: 0.55;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,0,0,0.15) 0%, rgba(0,0,0,0.55) 100%);
  }
  .hero-content {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    padding: 0 5rem 5rem;
  }
  .hero-title {
    font-weight: normal;
    color: var(--color-green, #b8f000);
    margin: 0;
    line-height: 0.9;
  }
  .script-p {
    font-family: 'Edwardian Script', cursive;
    font-size: clamp(6rem, 14vw, 13rem);
    font-weight: normal;
    display: inline-block;
    vertical-align: middle;
  }
  .hero-sans {
    font-family: Helvetica, Arial, sans-serif;
    font-size: clamp(4rem, 10vw, 9rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    vertical-align: middle;
  }

  .projets-body {
    background: #f5f5f0;
    padding: 4rem 5rem 8rem;
    min-height: 60vh;
  }
  .filtres-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 1rem;
    align-items: center;
  }
  .filtres-dynamic {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .filtre-btn {
    font-family: Helvetica, Arial, sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: #000;
    background: transparent;
    border: 1.5px solid rgba(0,0,0,0.25);
    border-radius: 50px;
    padding: 0.4rem 1.1rem;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  .filtre-btn:hover { border-color: #000; }
  .filtre-btn.active {
    background: #000;
    color: var(--color-green, #b8f000);
    border-color: #000;
  }
  .projets-meta { margin-bottom: 2.5rem; }
  .projets-count {
    font-family: Helvetica, Arial, sans-serif;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #999;
  }
  .projets-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.2rem;
  }
  .projets-loading {
    grid-column: 1 / -1;
    font-family: Helvetica, Arial, sans-serif;
    font-size: 0.85rem;
    color: #999;
    padding: 3rem 0;
  }
  .projet-card {
    position: relative;
    overflow: hidden;
    border-radius: 4px;
    background: #e0e0dc;
    aspect-ratio: 16/10;
    text-decoration: none;
    display: block;
    animation: cardIn 0.45s ease both;
  }
  @keyframes cardIn {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .projet-card img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.55s ease;
  }
  .projet-card:hover img { transform: scale(1.04); }
  .projet-card-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.5);
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .projet-card:hover .projet-card-overlay { opacity: 1; }
  .projet-card-infos {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.4rem;
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .projet-card:hover .projet-card-infos { opacity: 1; }
  .projet-card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }
  .projet-card-nom {
    font-family: Helvetica, Arial, sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #fff;
    line-height: 1.4;
    max-width: 65%;
  }
  .projet-card-voir {
    font-family: Helvetica, Arial, sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
    color: #fff;
    border: 1.5px solid rgba(255,255,255,0.7);
    border-radius: 50px;
    padding: 0.35rem 1rem;
    white-space: nowrap;
  }
  .projet-card-comps {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .projet-card-comp {
    font-family: Helvetica, Arial, sans-serif;
    font-size: 0.8rem;
    font-weight: 500;
    color: rgba(255,255,255,0.9);
    letter-spacing: 0.03em;
  }
  @media (max-width: 768px) {
    .projets-body { padding: 3rem 1.5rem 5rem; }
    .projets-grid { grid-template-columns: 1fr; }
    .projets-hero { height: 50vh; }
  }
</style>

<script>
  const PB_URL = 'http://127.0.0.1:8090';

  const cursor = document.getElementById('cursor') as HTMLElement;
  const dot = document.getElementById('cursor-dot') as HTMLElement;
  let cx = 0, cy = 0, tx = 0, ty = 0;

  document.addEventListener('mousemove', (e) => {
    tx = e.clientX; ty = e.clientY;
    dot.style.left = tx + 'px';
    dot.style.top = ty + 'px';
  });
  (function animCursor() {
    cx += (tx - cx) * 0.12;
    cy += (ty - cy) * 0.12;
    cursor.style.left = cx + 'px';
    cursor.style.top = cy + 'px';
    requestAnimationFrame(animCursor);
  })();

  let allProjets: any[] = [];
  let filtreActif = 'all';

  async function loadProjets() {
    try {
      const res = await fetch(`${PB_URL}/api/collections/projet/records?perPage=100&sort=-created`);
      const data = await res.json();
      allProjets = data.items || [];
      buildFiltres();
      renderProjets();
    } catch (err) {
      console.error('Erreur:', err);
      const grid = document.getElementById('projets-grid')!;
      grid.innerHTML = '<p style="color:#999;font-size:0.85rem;font-family:Helvetica,sans-serif;grid-column:1/-1">Erreur de chargement.</p>';
    }
  }

  function buildFiltres() {
    const allFiltres = new Set<string>();
    allProjets.forEach(p => {
      const filtres = Array.isArray(p.filtre_projet)
        ? p.filtre_projet
        : (p.filtre_projet || '').split(',').map((f: string) => f.trim()).filter(Boolean);
      filtres.forEach((f: string) => { if (f) allFiltres.add(f); });
    });

    const container = document.getElementById('filtres-dynamiques')!;
    container.innerHTML = '';

    allFiltres.forEach(filtre => {
      const btn = document.createElement('button');
      // Marque actif si c'est le filtre URL
      btn.className = 'filtre-btn' + (filtre === filtreActif ? ' active' : '');
      btn.dataset.filter = filtre;
      btn.textContent = filtre;
      btn.addEventListener('click', () => setFiltre(filtre));
      container.appendChild(btn);
    });

    // Bouton Tous
    const tousBtn = document.querySelector('[data-filter="all"]') as HTMLElement;
    if (tousBtn) {
      tousBtn.classList.toggle('active', filtreActif === 'all');
      tousBtn.addEventListener('click', () => setFiltre('all'));
    }
  }

  function setFiltre(filtre: string) {
    filtreActif = filtre;
    document.querySelectorAll('.filtre-btn').forEach(btn => {
      btn.classList.toggle('active', (btn as HTMLElement).dataset.filter === filtre);
    });
    renderProjets();
  }

  function renderProjets() {
    const grid = document.getElementById('projets-grid')!;
    const countEl = document.getElementById('projets-count')!;

    const filtered = filtreActif === 'all'
      ? allProjets
      : allProjets.filter(p => {
          const filtres = Array.isArray(p.filtre_projet)
            ? p.filtre_projet
            : (p.filtre_projet || '').split(',').map((f: string) => f.trim()).filter(Boolean);
          return filtres.includes(filtreActif);
        });

    countEl.textContent = `${filtered.length} projet${filtered.length > 1 ? 's' : ''}`;
    grid.innerHTML = filtered.length === 0
      ? '<p style="color:#999;font-size:0.85rem;font-family:Helvetica,sans-serif;grid-column:1/-1;padding:3rem 0">Aucun projet dans cette catégorie.</p>'
      : filtered.map((p, i) => buildCard(p, i)).join('');

    grid.querySelectorAll<HTMLElement>('.projet-card').forEach(card => {
      card.addEventListener('mouseenter', () => cursor.classList.add('hovering'));
      card.addEventListener('mouseleave', () => cursor.classList.remove('hovering'));
    });
  }

  function buildCard(p: any, i: number): string {
    const thumb = p.photo_projet
      ? `${PB_URL}/api/files/${p.collectionId}/${p.id}/${p.photo_projet}`
      : '';
    const comps: string[] = Array.isArray(p.competence_projet)
      ? p.competence_projet
      : (p.competence_projet || '').split(',').map((c: string) => c.trim()).filter(Boolean);
    const href = p.lien_projet ? `/projets/${p.lien_projet}` : '#';

    return `
      <a href="${href}" class="projet-card" style="animation-delay: ${i * 0.06}s">
        ${thumb ? `<img src="${thumb}" alt="${p.nom_projet}" loading="lazy" />` : '<div style="width:100%;height:100%;background:#ccc"></div>'}
        <div class="projet-card-overlay"></div>
        <div class="projet-card-infos">
          <div class="projet-card-top">
            <span class="projet-card-nom">${p.nom_projet}</span>
            <span class="projet-card-voir">Voir plus</span>
          </div>
          <div class="projet-card-comps">
            ${comps.map(c => `<span class="projet-card-comp">${c}</span>`).join('')}
          </div>
        </div>
      </a>
    `;
  }

  // ── Lire ?filtre= dans l'URL AVANT de charger ──
  const params = new URLSearchParams(window.location.search);
  const filtreUrl = params.get('filtre');
  if (filtreUrl) {
    filtreActif = filtreUrl;
  }

  loadProjets();
</script>