---
// src/pages/projets/index.astro
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import headerVideo from '../../assets/header_projets.mp4';
import { projets } from '../../data/projets';
import { getImage } from '../../data/images';

// Filtres générés à partir des données (ordre d'apparition)
const filtres = [...new Set(projets.flatMap((p) => p.filtres))];
---

<Layout title="Projets — Lison Pruvost">

  <div class="custom-cursor" id="cursor"></div>
  <div class="custom-cursor-dot" id="cursor-dot"></div>

  <section class="projets-hero">
    <video class="hero-video" autoplay loop muted playsinline>
      <source src={headerVideo} type="video/mp4" />
    </video>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <h1 class="hero-title">
        <span class="script-p">P</span><span class="hero-sans">rojets</span>
      </h1>
    </div>
  </section>

  <section class="projets-body">
    <div class="filtres-wrap">
      <button class="filtre-btn active" data-filter="all">Tous</button>
      <div class="filtres-dynamic">
        {filtres.map((f) => (
          <button class="filtre-btn" data-filter={f}>{f}</button>
        ))}
      </div>
    </div>
    <div class="projets-meta">
      <span id="projets-count" class="projets-count">{projets.length} projet{projets.length > 1 ? 's' : ''}</span>
    </div>

    <div class="projets-grid" id="projets-grid">
      {projets.map((p, i) => (
        <a
          href={`/projets/${p.slug}`}
          class="projet-card"
          data-filtres={JSON.stringify(p.filtres)}
          style={`animation-delay: ${i * 0.06}s`}
        >
          <Image
            src={getImage(p.photo)}
            alt={p.nom}
            widths={[600, 900, 1200]}
            sizes="(max-width: 768px) 100vw, 50vw"
            loading="lazy"
          />
          <div class="projet-card-overlay"></div>
          <div class="projet-card-infos">
            <div class="projet-card-top">
              <span class="projet-card-nom">{p.nom}</span>
              <span class="projet-card-voir">Voir plus</span>
            </div>
            <div class="projet-card-comps">
              {p.competencesCarte.map((c) => (
                <span class="projet-card-comp">{c}</span>
              ))}
            </div>
          </div>
        </a>
      ))}
      <p class="projets-empty" id="projets-empty" hidden>Aucun projet dans cette catégorie.</p>
    </div>
  </section>

</Layout>

<style is:global>
  * { cursor: none; }

  .custom-cursor {
    width: 36px; height: 36px;
    border: 1.5px solid var(--color-green, #b8f000);
    border-radius: 50%;
    position: fixed; top: 0; left: 0;
    pointer-events: none; z-index: 9999;
    transform: translate(-50%, -50%);
    transition: width 0.2s, height 0.2s, background 0.2s;
    mix-blend-mode: difference;
  }
  .custom-cursor-dot {
    width: 5px; height: 5px;
    background: var(--color-green, #b8f000);
    border-radius: 50%;
    position: fixed; top: 0; left: 0;
    pointer-events: none; z-index: 10000;
    transform: translate(-50%, -50%);
  }
  .custom-cursor.hovering { width: 56px; height: 56px; background: rgba(184,240,0,0.08); }

  .projets-hero {
    position: relative;
    height: 100vh;
    overflow: hidden;
    background: #000;
  }
  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    opacity: 0.55;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,0,0,0.15) 0%, rgba(0,0,0,0.55) 100%);
  }
  .hero-content {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    padding: 0 5rem 5rem;
  }
  .hero-title {
    font-weight: normal;
    color: var(--color-green, #b8f000);
    margin: 0;
    line-height: 0.9;
  }
  .script-p {
    font-family: 'Edwardian Script', cursive;
    font-size: clamp(6rem, 14vw, 13rem);
    font-weight: normal;
    display: inline-block;
    vertical-align: middle;
  }
  .hero-sans {
    font-family: Helvetica, Arial, sans-serif;
    font-size: clamp(4rem, 10vw, 9rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    vertical-align: middle;
  }

  .projets-body {
    background: #f5f5f0;
    padding: 4rem 5rem 8rem;
    min-height: 60vh;
  }
  .filtres-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 1rem;
    align-items: center;
  }
  .filtres-dynamic {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .filtre-btn {
    font-family: Helvetica, Arial, sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: #000;
    background: transparent;
    border: 1.5px solid rgba(0,0,0,0.25);
    border-radius: 50px;
    padding: 0.4rem 1.1rem;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  .filtre-btn:hover { border-color: #000; }
  .filtre-btn.active {
    background: #000;
    color: var(--color-green, #b8f000);
    border-color: #000;
  }
  .projets-meta { margin-bottom: 2.5rem; }
  .projets-count {
    font-family: Helvetica, Arial, sans-serif;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #999;
  }
  .projets-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.2rem;
  }
  .projets-empty {
    grid-column: 1 / -1;
    font-family: Helvetica, Arial, sans-serif;
    font-size: 0.85rem;
    color: #999;
    padding: 3rem 0;
    margin: 0;
  }
  .projets-empty[hidden] { display: none; }

  .projet-card {
    position: relative;
    overflow: hidden;
    border-radius: 4px;
    background: #e0e0dc;
    aspect-ratio: 16/10;
    text-decoration: none;
    display: block;
    animation: cardIn 0.45s ease both;
  }
  .projet-card.is-hidden { display: none; }
  @keyframes cardIn {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .projet-card img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.55s ease;
  }
  .projet-card:hover img { transform: scale(1.04); }
  .projet-card-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.5);
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .projet-card:hover .projet-card-overlay { opacity: 1; }
  .projet-card-infos {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.4rem;
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .projet-card:hover .projet-card-infos { opacity: 1; }
  .projet-card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }
  .projet-card-nom {
    font-family: Helvetica, Arial, sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #fff;
    line-height: 1.4;
    max-width: 65%;
  }
  .projet-card-voir {
    font-family: Helvetica, Arial, sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
    color: #fff;
    border: 1.5px solid rgba(255,255,255,0.7);
    border-radius: 50px;
    padding: 0.35rem 1rem;
    white-space: nowrap;
  }
  .projet-card-comps {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .projet-card-comp {
    font-family: Helvetica, Arial, sans-serif;
    font-size: 0.8rem;
    font-weight: 500;
    color: rgba(255,255,255,0.9);
    letter-spacing: 0.03em;
  }
  @media (max-width: 768px) {
    .projets-body { padding: 3rem 1.5rem 5rem; }
    .projets-grid { grid-template-columns: 1fr; }
    .projets-hero { height: 50vh; }
  }
</style>

<script>
  // ── Curseur ──
  const cursor = document.getElementById('cursor') as HTMLElement;
  const dot = document.getElementById('cursor-dot') as HTMLElement;
  let cx = 0, cy = 0, tx = 0, ty = 0;

  document.addEventListener('mousemove', (e) => {
    tx = e.clientX; ty = e.clientY;
    dot.style.left = tx + 'px';
    dot.style.top = ty + 'px';
  });
  (function animCursor() {
    cx += (tx - cx) * 0.12;
    cy += (ty - cy) * 0.12;
    cursor.style.left = cx + 'px';
    cursor.style.top = cy + 'px';
    requestAnimationFrame(animCursor);
  })();

  // ── Filtres (les cartes sont déjà dans le HTML, on les affiche/masque) ──
  const buttons = document.querySelectorAll<HTMLElement>('.filtre-btn');
  const cards = document.querySelectorAll<HTMLElement>('.projet-card');
  const countEl = document.getElementById('projets-count')!;
  const emptyEl = document.getElementById('projets-empty')!;

  cards.forEach((card) => {
    card.addEventListener('mouseenter', () => cursor.classList.add('hovering'));
    card.addEventListener('mouseleave', () => cursor.classList.remove('hovering'));
  });

  function setFiltre(filtre: string) {
    let visible = 0;
    cards.forEach((card) => {
      const filtres: string[] = JSON.parse(card.dataset.filtres || '[]');
      const show = filtre === 'all' || filtres.includes(filtre);
      card.classList.toggle('is-hidden', !show);
      if (show) visible++;
    });
    buttons.forEach((b) => b.classList.toggle('active', b.dataset.filter === filtre));
    countEl.textContent = `${visible} projet${visible > 1 ? 's' : ''}`;
    emptyEl.hidden = visible > 0;
  }

  buttons.forEach((btn) => btn.addEventListener('click', () => setFiltre(btn.dataset.filter!)));

  // ?filtre=Photographie dans l'URL
  const filtreUrl = new URLSearchParams(window.location.search).get('filtre');
  if (filtreUrl) setFiltre(filtreUrl);
</script>